# ============================================================
# Social Media Dashboard — environment variables
# Copy to .env (local) or configure in Vercel project settings.
# NEVER expose these values to the client (no NEXT_PUBLIC_ prefix).
# ============================================================

# ------------------------------------------------------------
# OAuth / Connected Accounts (preferred path)
# ------------------------------------------------------------

# YouTube / Google OAuth 2.0
# Authorized redirect URI: {APP_ORIGIN}/api/auth/youtube/callback
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
# Optional explicit override; defaults to {APP_ORIGIN}/api/auth/youtube/callback
# GOOGLE_REDIRECT_URI="https://your-app.vercel.app/api/auth/youtube/callback"

# Meta (Facebook Page + Instagram Business) OAuth 2.0
# Authorized redirect URI: {APP_ORIGIN}/api/auth/facebook/callback
#                          {APP_ORIGIN}/api/auth/instagram/callback
META_CLIENT_ID="your_meta_app_id"
META_CLIENT_SECRET="your_meta_app_secret"
# META_REDIRECT_URI="https://your-app.vercel.app/api/auth/facebook/callback"

# Threads OAuth (Meta app with the "Access the Threads API" use case)
# Authorized redirect URI: {APP_ORIGIN}/api/auth/threads/callback
THREADS_CLIENT_ID="your_threads_app_id"
THREADS_CLIENT_SECRET="your_threads_app_secret"
# THREADS_REDIRECT_URI="https://your-app.vercel.app/api/auth/threads/callback"

# TikTok Login Kit (OAuth v2)
# Authorized redirect URI: {APP_ORIGIN}/api/auth/tiktok/callback
TIKTOK_CLIENT_KEY="your_tiktok_client_key"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"
# TIKTOK_REDIRECT_URI="https://your-app.vercel.app/api/auth/tiktok/callback"

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# 32+ char secret used to encrypt OAuth tokens at rest (AES-256-GCM) and to
# sign OAuth state. REQUIRED for connecting accounts.
TOKEN_ENCRYPTION_KEY="a_long_random_secret_string"

# Fixed owner id for this single-owner deployment (multi-user ready).
OWNER_ID="owner"

# ------------------------------------------------------------
# Caching
# ------------------------------------------------------------

# Aggregate stats cache TTL in seconds (3 hours).
REVALIDATE_TIME=10800
# Content-level cache TTL in seconds (1 hour).
CONTENT_REVALIDATE_TIME=3600

# ------------------------------------------------------------
# Firebase Admin SDK (Firestore: cache, snapshots, connected accounts)
# ------------------------------------------------------------
FIREBASE_PROJECT_ID="your_firebase_project_id_here"
FIREBASE_CLIENT_EMAIL="your_firebase_service_account_email_here"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# LEGACY (developer-configured) fallback — optional
# ------------------------------------------------------------
# The dashboard prefers OAuth connected accounts. These remain only as a
# fallback for the legacy /api/stats + /api/dashboard endpoints.
YOUTUBE_API_KEY="your_google_cloud_api_key_here"
YOUTUBE_CHANNEL_ID="your_youtube_channel_id_or_@handle_here"
RAPIDAPI_KEY="your_rapidapi_key_here"
RAPIDAPI_HOST_INSTAGRAM="instagram-looter2.p.rapidapi.com"
RAPIDAPI_HOST_FACEBOOK="facebook-scraper3.p.rapidapi.com"
RAPIDAPI_HOST_THREADS="threads-api4.p.rapidapi.com"
RAPIDAPI_HOST_TIKTOK="tiktok-api23.p.rapidapi.com"
INSTAGRAM_USERNAME="your_instagram_username"
FACEBOOK_PROFILE_URL="https://www.facebook.com/your-profile"
THREADS_USERNAME="your_threads_username"
TIKTOK_USERNAME="your_tiktok_username"
