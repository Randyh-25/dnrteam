# ============================================================
# Social Media Dashboard — environment variables
# Copy to .env (local) or configure in Vercel project settings.
# Never expose these values to the client.
# ============================================================

# YouTube Data API v3
# API key: https://console.cloud.google.com/apis/credentials
# Channel reference accepts a channel ID (UC...), legacy username, or @handle.
YOUTUBE_API_KEY="your_google_cloud_api_key_here"
YOUTUBE_CHANNEL_ID="your_youtube_channel_id_or_@handle_here"

# Meta (Facebook Page, Instagram Business, Threads)
# Long-lived access token from https://developers.facebook.com/tools/explorer
META_ACCESS_TOKEN="your_long_lived_access_token_here"
FB_PAGE_ID="your_facebook_page_id_here"
IG_USER_ID="your_instagram_business_account_id_here"
THREADS_USER_ID="your_threads_user_id_here"

# TikTok (via RapidAPI aggregator)
# https://rapidapi.com/ — default host is tiktok-scraper7.p.rapidapi.com
RAPIDAPI_KEY="your_rapidapi_key_here"
TIKTOK_USERNAME="your_tiktok_username_here"
# Optional: override if you use a different RapidAPI TikTok provider.
RAPIDAPI_TIKTOK_HOST="tiktok-scraper7.p.rapidapi.com"

# Cache TTL in seconds. Defaults to 3 hours (10800) per PLAN.md.
REVALIDATE_TIME=10800

# Firebase Admin SDK (Firestore cache + historical snapshots)
# Service account JSON fields from Firebase Console → Project settings.
FIREBASE_PROJECT_ID="your_firebase_project_id_here"
FIREBASE_CLIENT_EMAIL="your_firebase_service_account_email_here"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
